{
  "name": "stamp-loupe",
  "version": "2.1.0",
  "description": "Open-source stamp identification, valuation and selling planner with cheque-style photo capture.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-artifact.mjs",
    "build:site": "node scripts/build-site.mjs",
    "serve": "python3 -m http.server 8080",
    "serve:site": "python3 -m http.server 8080 --directory dist/site"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  },
  "engines": {
    "node": ">=20"
  }
}
